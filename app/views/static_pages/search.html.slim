.container
  .row.col-lg-12 data-animation-effect="fadeInUpSmall" data-effect-delay="200"
    h1.title.text-center 搜尋：#{@query}
    .separator

- if @articles.any?
  .container
    .separator-2
    .filters
      ul.nav.nav-tabs
        li class=("active" if @kind.blank?)
          = link_to "所有", search_path(q: @query)
        - StaticPagesController::SEARCH_KINDS.each do |k, kind|
          li class=("active" if @kind == k)
            = link_to Article::KIND_NAMES[kind], search_path(q: @query, k: k)
    .row
      .block.clearfix.isotope-container
        - @articles.each do |a|
          .list-with-image.isotope-item.col-md-4 class="jrf-#{a.kind}"
            .overlay-container
              - if a.youtube_id.present?
                iframe.embed-responsive-item src="//www.youtube.com/embed/#{a.youtube_id}"
              - elsif a.image.present?
                = image_tag(a.image.url, alt: a.title)
              = link_to article_path(a), class: "overlay small" do
                i.fa.fa-link
                span = Article::KIND_NAMES[a.kind]
            h2
              = link_to a.title, article_path(a)
            p.small = a.published_at.strftime('%Y-%m-%d')
    .row.text-center
      .col-md-10.col-md-offset-1
        = paginate @articles
